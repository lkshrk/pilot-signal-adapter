{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
  ],
  timezone: "Europe/Berlin",
  schedule: ["* 0-6 * * 1"],
  labels: ["renovate"],
  packageRules: [
    {
      description: "Group Go module updates",
      matchManagers: ["gomod"],
      groupName: "go modules",
    },
    {
      description: "The go directive tracks pilot's, not the newest release — pilot must be able to import this module.",
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      enabled: false,
    },
  ],
}
